# Copy to backend/.env. Do not commit the real file.

APP_ENV=development
APP_NAME=Recall Me Maybe
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

DATABASE_URL=sqlite:///./data/signal.db

# Search priority: Exa → Brave → Gemini. OpenAI = embeddings only.
# Paste Exa key after EXA_API_KEY= (from https://dashboard.exa.ai) and save the file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SEED_DEMO=false
SEED_FAKE_POSTS=true
CPSC_RECALL_LIMIT=25
FDA_FOOD_RECALL_LIMIT=25
HOME_SCRAPE_PRODUCTS=2
HOME_SCRAPE_PAGES=3
HOME_SCRAPE_QUERIES=1
SEARCH_SCRAPE_PAGES=5
DISCOVERY_COOLDOWN_MINUTES=20

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

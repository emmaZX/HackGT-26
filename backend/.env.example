# Copy to backend/.env. Do not commit the real file.
# The API also reads the repo-root .env. Put Cognito IDs in both so
# uvicorn finds them no matter which folder you start from.
# GET /health returns "auth": true when the pool and client IDs are set.

APP_ENV=development
APP_NAME=Recall Me Maybe
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Relative SQLite paths resolve to this backend folder: data/signal.db
DATABASE_URL=sqlite:///./data/signal.db

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Search priority: Exa → Brave → Gemini. OpenAI = embeddings / optional web search.
# Paste Exa key after EXA_API_KEY= (from https://dashboard.exa.ai) and save the file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_SEARCH_MODEL=gpt-4o

# xAI Grok — X food-complaint sweep (see run_x_sweep.py). Required for partner-style food cards.
XAI_API_KEY=

# Freeze the demo on the current database — no crawls / overlays / live discovery.
SNAPSHOT_MODE=true

SEED_DEMO=false
SEED_FAKE_POSTS=false
CPSC_RECALL_LIMIT=25
FDA_FOOD_RECALL_LIMIT=25
HOME_SCRAPE_PRODUCTS=0
HOME_SCRAPE_PAGES=3
HOME_SCRAPE_QUERIES=1
SEARCH_SCRAPE_PAGES=5
DISCOVERY_COOLDOWN_MINUTES=20
DISCOVERY_RECENCY_DAYS=90
CAERS_LOOKBACK_DAYS=90
CAERS_FETCH_LIMIT=3000
CAERS_SPIKE_MIN_REPORTS=5
CAERS_SPIKE_VELOCITY=2.0
FSIS_RECALL_LIMIT=40
OUTBREAK_LIMIT=15

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

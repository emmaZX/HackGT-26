# Copy this file to `.env` in the repo root (or into backend/ and frontend/).
# Never commit a real `.env`. All secrets stay on your machine.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Recall Me Maybe
CORS_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Database
# SQLite is the default so the demo runs with zero cloud setup.
# To use Supabase/Postgres later, set DATABASE_URL to the pooled URI.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/signal.db
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Frontend (safe to expose — no secrets)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=Recall Me Maybe

# ---------------------------------------------------------------------------
# AI — keep these server-side only. Pick whichever provider you have.
# The app works from seed data if none are set.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional override if you use a Vertex or proxy endpoint
GEMINI_MODEL=gemini-2.0-flash

# Exa is a strong fallback for conceptual web search without site-specific APIs
EXA_API_KEY=

# Brave Search is the free-tier fallback
BRAVE_SEARCH_API_KEY=

# Embeddings (optional). If empty, SIGNAL uses a local lexical fallback.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Storage (optional — local disk is used if unset)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Maps
# Leaflet + OSM is the default (no key). Set a token only if you switch to Mapbox.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

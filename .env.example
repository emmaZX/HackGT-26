# Copy this file to `.env` in the repo root (or into backend/ and frontend/).
# Never commit a real `.env`. All secrets stay on your machine.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Recall Me Maybe
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/signal.db

# ---------------------------------------------------------------------------
# Frontend (safe to expose — no secrets)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=Recall Me Maybe

# ---------------------------------------------------------------------------
# AI / search — keep these server-side only.
# Brave alone is enough for live discovery. Gemini improves extraction.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Live bootstrap (hybrid demo)
# SEED_DEMO=true restores the old Acme/Harborline fiction path.
# ---------------------------------------------------------------------------
SEED_DEMO=false
SEED_FAKE_POSTS=true
CPSC_RECALL_LIMIT=25
HOME_SCRAPE_PRODUCTS=5
HOME_SCRAPE_PAGES=3
HOME_SCRAPE_QUERIES=2
SEARCH_SCRAPE_PAGES=8
DISCOVERY_COOLDOWN_MINUTES=20

# ---------------------------------------------------------------------------
# Storage (optional)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_MAPBOX_TOKEN=

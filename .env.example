# Copy this file to `.env` in the repo root (or into backend/ and frontend/).
# Never commit a real `.env`. All secrets stay on your machine.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Recall Me Maybe
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Database
# SQLite is the default so the demo runs with zero cloud setup.
# A relative path always resolves under backend/ (backend/data/signal.db).
# To use Supabase/Postgres later, set DATABASE_URL to the pooled URI.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/signal.db

# ---------------------------------------------------------------------------
# AWS Cognito (signup / login)
# User pool IDs are public browser config. Never put a client secret here.
# Create a User Pool as a Single-page application (SPA).
# Display name can be the name or preferred_username attribute.
# Backend reads COGNITO_* from this file and backend/.env.
# Next.js only reads frontend/.env.local (NEXT_PUBLIC_COGNITO_USER_POOL_ID
# and NEXT_PUBLIC_COGNITO_APP_CLIENT_ID). It does not use a region var.
# See README "Sign in with Cognito". Restart both servers after edits.
# ---------------------------------------------------------------------------
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# ---------------------------------------------------------------------------
# Frontend (safe to expose — no secrets)
# Next.js only reads these from frontend/.env.local, not from this file.
# Leave NEXT_PUBLIC_API_URL empty to proxy /api and /health to :8000.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=

# ---------------------------------------------------------------------------
# AI / search — keep these server-side only. Never commit real keys.
#
# Search priority in code: Exa → Brave → Gemini
#   EXA_API_KEY     = niche / semantic web search (Reddit, blogs, forums) — preferred
#   BRAVE_SEARCH_API_KEY = optional keyword web search
#   GEMINI_API_KEY  = optional; Google grounding search + extraction
#   OPENAI_API_KEY  = embeddings / semantic similarity (not web search)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# OpenAI is optional. If empty, Brave / Gemini / Exa still work when set.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_SEARCH_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Live bootstrap (hybrid demo)
# SEED_DEMO=true restores the old Acme/Harborline fiction path.
# ---------------------------------------------------------------------------
# Live bootstrap — home catalog is FDA food recalls.
# Physical product scrapes only run when someone searches for a specific device.
SEED_DEMO=false
SEED_FAKE_POSTS=true
CPSC_RECALL_LIMIT=25
FDA_FOOD_RECALL_LIMIT=25
HOME_SCRAPE_PRODUCTS=2
HOME_SCRAPE_PAGES=3
HOME_SCRAPE_QUERIES=1
SEARCH_SCRAPE_PAGES=5
DISCOVERY_COOLDOWN_MINUTES=20

# ---------------------------------------------------------------------------
# Storage (optional — not wired yet. Uploads stay on local disk.)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Copy to frontend/.env.local. These values are public browser config only.
# Never put API keys here — they would ship to every visitor.

# Leave empty to proxy /api and /health through Next.js to FastAPI on :8000.
NEXT_PUBLIC_API_URL=

# AWS Cognito — same public IDs as the root / backend .env.
# Restart Next after edits. No client secret. Next.js does not read the
# repo-root .env. Region is already inside the pool id.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
